{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kazene.org/schemas/yin-yang-five-phase-circulation-protocol/0.3.0/residual-observation-record.schema.json",
  "title": "Residual Observation Record",
  "description": "Records a residual generated by a system action before classification or recovery decisions are made.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "observation_id",
    "cycle_id",
    "origin_ref",
    "source_execution_ref",
    "source_phase",
    "residual_type",
    "observed_at",
    "quantity",
    "containment_level",
    "description"
  ],
  "properties": {
    "schema_version": {"const": "0.3.0"},
    "observation_id": {"$ref": "#/$defs/identifier"},
    "cycle_id": {"$ref": "#/$defs/identifier"},
    "origin_ref": {"$ref": "#/$defs/reference"},
    "source_execution_ref": {"$ref": "#/$defs/reference"},
    "source_phase": {"$ref": "#/$defs/phase"},
    "residual_type": {
      "enum": [
        "thermal",
        "computational",
        "temporal",
        "informational",
        "economic"
      ]
    },
    "observed_at": {"type": "string", "format": "date-time"},
    "quantity": {"$ref": "#/$defs/quantity"},
    "containment_level": {
      "enum": ["open", "restricted", "quarantined"]
    },
    "content_fingerprint": {
      "type": "string",
      "minLength": 8,
      "maxLength": 256
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 2000
    },
    "evidence_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/reference"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 160,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    },
    "phase": {
      "enum": ["wood", "fire", "earth", "metal", "water"]
    },
    "quantity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["value", "unit"],
      "properties": {
        "value": {"type": "number", "exclusiveMinimum": 0},
        "unit": {"type": "string", "minLength": 1, "maxLength": 80}
      }
    }
  }
}
