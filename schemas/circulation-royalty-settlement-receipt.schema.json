{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kazene.org/schemas/yin-yang-five-phase-circulation-protocol/0.5.0/circulation-royalty-settlement-receipt.schema.json",
  "title": "Circulation Royalty Settlement Receipt",
  "description": "Settles auditable value generated by a circulation operation without bypassing provenance or unresolved disputes.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "settlement_id",
    "profile_ref",
    "binding_ref",
    "audit_ref",
    "context",
    "settlement_status",
    "value",
    "allocations",
    "unresolved_dispute_refs",
    "recorded_at"
  ],
  "properties": {
    "schema_version": {
      "const": "0.5.0"
    },
    "settlement_id": {
      "$ref": "#/$defs/identifier"
    },
    "profile_ref": {
      "$ref": "#/$defs/reference"
    },
    "binding_ref": {
      "$ref": "#/$defs/reference"
    },
    "audit_ref": {
      "$ref": "#/$defs/reference"
    },
    "context": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "context_type",
        "context_id"
      ],
      "properties": {
        "context_type": {
          "enum": [
            "cycle",
            "federation_epoch"
          ]
        },
        "context_id": {
          "$ref": "#/$defs/identifier"
        }
      }
    },
    "settlement_status": {
      "enum": [
        "settled",
        "held",
        "rejected"
      ]
    },
    "value": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "gross_amount",
        "unit"
      ],
      "properties": {
        "gross_amount": {
          "type": "number",
          "minimum": 0
        },
        "unit": {
          "type": "string",
          "minLength": 1,
          "maxLength": 80
        }
      }
    },
    "allocations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "beneficiary_ref",
          "role",
          "share_ratio",
          "amount"
        ],
        "properties": {
          "beneficiary_ref": {
            "$ref": "#/$defs/reference"
          },
          "role": {
            "enum": [
              "originator",
              "operator",
              "infrastructure",
              "community_fund",
              "auditor"
            ]
          },
          "share_ratio": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          },
          "amount": {
            "type": "number",
            "minimum": 0
          }
        }
      }
    },
    "unresolved_dispute_refs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "$ref": "#/$defs/reference"
      }
    },
    "ledger_ref": {
      "$ref": "#/$defs/reference"
    },
    "settled_at": {
      "type": "string",
      "format": "date-time"
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "value_attribution_ref": {
      "$ref": "#/$defs/reference"
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200,
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._:-]*$"
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 512
    }
  }
}
